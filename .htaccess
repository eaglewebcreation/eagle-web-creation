# Eagle Web Creation TEST SITE (seo-preview branch only). Never merge this commit to main.
# Redirects stay on the test host, and search engines are kept out.
RewriteEngine On

# Clean page addresses: /index.html goes to /, and /about.html goes to /about
# (checked first, so http://www.../about.html also lands on /about in one hop)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# A trailing slash on a page address (/pricing/) goes to the page (/pricing)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/$ /$1 [R=301,L]

# http goes to https on the test host
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Serve /about from about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

DirectoryIndex index.html

# Missing pages show the site's own 404 page (it is marked noindex)
ErrorDocument 404 /404.html

# Keep search engines out of the test site
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
